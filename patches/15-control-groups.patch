+				if (canSelectPlayer(member.getPlayer())) {
+					members.add(member);
+				}
+			}
+		}
+		controlGroups[group] = members; // forget the dead ones
+
+		if (!members.isEmpty()) {
+			setSelection(new SelectionSet(members));
+		}
